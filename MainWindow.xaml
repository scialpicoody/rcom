<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Rcom.MainWindow"
        Title="rcom"
        Width="1120" Height="680">
  <!-- The tracer-bullet layout grown its right-hand quick-send bar (ticket #17):
       left = log view + toolbar (port/baud/open/encoding/hide-sent/send); right =
       the quick-send pages. Visible strings are set from the controller via `t!`
       (the i18n dictionaries), so the XAML carries none. -->
  <Grid ColumnDefinitions="*,320" Margin="8">
    <!-- Left: log view on top, the toolbar/send bar below, the tools pane at the
         bottom. ISSUE #20 (lane2): the bottom pane is this TabControl with the
         net tools tab; when the #19 bottom tab pane lands, move this single
         x:Name="NetToolsTab" TabItem into that TabControl and delete this
         wrapper (the page is wired by name from src/app/tools_net.rs, so its
         position does not matter). -->
    <Grid Grid.Column="0" RowDefinitions="*,Auto,240">
      <ListBox x:Name="LogList"
               Grid.Row="0"
               FontSize="13" />

      <Grid Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
            Margin="0,8,0,0">
        <TextBlock x:Name="PortCaption"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,4,0" />
        <ComboBox x:Name="PortSelector"
                  Grid.Column="1"
                  MinWidth="150"
                  Margin="0,0,6,0" />
        <Button x:Name="RefreshButton"
                Grid.Column="2"
                MinWidth="70"
                Margin="0,0,6,0" />
        <TextBlock x:Name="BaudCaption"
                   Grid.Column="3"
                   VerticalAlignment="Center"
                   Margin="0,0,4,0" />
        <ComboBox x:Name="BaudSelector"
                  Grid.Column="4"
                  MinWidth="90"
                  Margin="0,0,6,0" />
        <Button x:Name="OpenCloseButton"
                Grid.Column="5"
                MinWidth="80"
                Margin="0,0,6,0" />
        <TextBlock x:Name="EncodingCaption"
                   Grid.Column="6"
                   VerticalAlignment="Center"
                   Margin="0,0,4,0" />
        <ComboBox x:Name="EncodingSelector"
                  Grid.Column="7"
                  MinWidth="100"
                  Margin="0,0,6,0" />
        <!-- The hide-sent filter: view-only (contract §2.1 — presentation options
             are viewmodel state); the log store and auto-save file stay complete.
             The content string comes from the controller (`t!("hide_sent")`). -->
        <CheckBox x:Name="HideSentToggle"
                  Grid.Column="8"
                  Margin="0,0,12,0" />
        <TextBox x:Name="SendBox"
                 Grid.Column="9"
                 Margin="0,0,6,0" />
        <Button x:Name="SendButton"
                Grid.Column="10"
                MinWidth="90" />
      </Grid>

      <!-- ISSUE #20: the net tools page. The XAML carries no visible strings —
           src/app/tools_net.rs sets every label from the i18n dictionaries and
           wires the controls by these names. -->
      <TabControl x:Name="ToolsTabs"
                  Grid.Row="2"
                  Margin="0,8,0,0">
        <TabItem x:Name="NetToolsTab">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="6">
              <ComboBox x:Name="NetProtocolSelector"
                        MinWidth="100" />
              <ComboBox x:Name="NetModeSelector"
                        MinWidth="90" />
              <CheckBox x:Name="NetCertCheck"
                        VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,6,0,0">
              <TextBox x:Name="NetHostBox"
                       MinWidth="170" />
              <TextBox x:Name="NetPortBox"
                       MinWidth="80" />
              <Button x:Name="NetStartButton"
                      MinWidth="90" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,6,0,0">
              <CheckBox x:Name="NetBridgeCheck"
                        VerticalAlignment="Center" />
              <TextBlock x:Name="NetStatus"
                         FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,6,0,0">
              <TextBox x:Name="NetSendBox"
                       MinWidth="260" />
              <Button x:Name="NetSendButton"
                      MinWidth="70" />
            </StackPanel>

            <ListBox x:Name="NetLog"
                     Grid.Row="4"
                     FontSize="12"
                     Margin="0,6,0,0" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Right: the quick-send pages (10 pages, unlimited entries per page). -->
    <Grid Grid.Column="1"
          RowDefinitions="Auto,Auto,*,Auto"
          Margin="12,0,0,0">
      <StackPanel Grid.Row="0"
                  Orientation="Horizontal"
                  Spacing="8">
        <TextBlock x:Name="QuickSendTitle"
                   FontSize="13" />
        <TextBlock x:Name="QuickSendPageLabel"
                   FontSize="11" />
      </StackPanel>

      <PipsPager x:Name="QuickSendPager"
                 Grid.Row="1"
                 Margin="0,6,0,6" />

      <ScrollViewer Grid.Row="2">
        <StackPanel x:Name="QuickSendEntries"
                    Spacing="4" />
      </ScrollViewer>

      <Grid Grid.Row="3"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto"
            Margin="0,8,0,0">
        <TextBlock x:Name="QuickSendLabelCaption"
                   Grid.Row="0" Grid.Column="0"
                   Margin="0,0,6,4"
                   FontSize="12" />
        <TextBox x:Name="QuickSendLabelBox"
                 Grid.Row="0" Grid.Column="1"
                 Margin="0,0,0,4" />
        <TextBlock x:Name="QuickSendPayloadCaption"
                   Grid.Row="1" Grid.Column="0"
                   Margin="0,0,6,4"
                   FontSize="12" />
        <TextBox x:Name="QuickSendPayloadBox"
                 Grid.Row="1" Grid.Column="1"
                 Margin="0,0,0,4" />
        <CheckBox x:Name="QuickSendHexCheck"
                  Grid.Row="2" Grid.Column="0"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4">
          <Button x:Name="QuickSendAddButton"
                  MinWidth="56" />
          <Button x:Name="QuickSendSaveButton"
                  MinWidth="56" />
          <Button x:Name="QuickSendDeleteButton"
                  MinWidth="56" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
